# =========================================================================
# ResiHome Compliance — Environment Variables (EXAMPLE)
# -------------------------------------------------------------------------
# Copy to `.env.local` for local development. NEVER commit real secrets.
# In production, set these in the Vercel Project Settings → Environment
# Variables (Production scope). See docs/ENVIRONMENT.md.
# =========================================================================

# --- HubSpot (Private App token) ---------------------------------------
# Create a Private App in HubSpot and copy its access token.
# Scopes typically needed: crm.objects.contacts.read, crm.objects.companies.read,
# crm.objects.deals.read, crm.objects.tickets.read (adjust to your use case).
HUBSPOT_TOKEN=
#
# Ticket pipeline ids the Utility Guide references for its "live bump".
# Utilities defaults to the known Utilities Activation pipeline (80932995);
# set the Compliance-Issues id to light up its live ticket count.
HUBSPOT_UTILITIES_PIPELINE_ID=
HUBSPOT_COMPLIANCE_ISSUES_PIPELINE_ID=

# --- Snowflake ----------------------------------------------------------
# Queries run over the Snowflake SQL REST API (no heavy Node driver).
# Auth is key-pair JWT (preferred) or an OAuth token — NOT a password.
#
# Account identifier, e.g. "orgname-accountname" (preferred) or a legacy
# locator like "abc12345.us-east-1".
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
#
# --- Auth: choose ONE -----
# (a) Key-pair JWT (recommended). The user must have RSA_PUBLIC_KEY set in
#     Snowflake (`ALTER USER ... SET RSA_PUBLIC_KEY='...'`). Provide the
#     matching PRIVATE key here — PEM (PKCS#8), or the same PEM with literal
#     \n escapes, or base64 of the PEM/DER (handy for single-line env values).
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=   # only if the private key is encrypted
# (b) OAuth token (alternative). Used verbatim as a bearer token.
SNOWFLAKE_OAUTH_TOKEN=
#
# Session context (optional but recommended):
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
#
# Optional overrides (rarely needed):
SNOWFLAKE_HOST=          # full REST host, if it differs from <account>.snowflakecomputing.com
SNOWFLAKE_JWT_ACCOUNT=   # JWT account identifier, if it differs from SNOWFLAKE_ACCOUNT

# --- ResiAIMS associations (HOA) schema mapping -------------------------
# The /associations feature reads HOA/association data from the same
# Snowflake account (creds above). The defaults in src/lib/associations.ts
# already target the real ResiAIMS warehouse objects (confirmed against
# PROD_ANALYTICS.DBT_RESICAP), so these vars are OPTIONAL — set one only to
# repoint that specific table/column if the warehouse layout changes. Leave
# blank to use the defaults. Every default has a matching RESIAIMS_* override;
# see src/lib/associations.ts for the complete list.
#
# Database + schema the association objects live in
# (defaults: PROD_ANALYTICS / DBT_RESICAP):
RESIAIMS_DATABASE=
RESIAIMS_SCHEMA=
# Tables (bare table, or fully-qualified DB.SCHEMA.TABLE). Defaults:
#   DIM_HOA, FCT_HOA_PROPERTY, FCT_HOA_ACCESS_CODE_ACCUM, FCT_HOA_ACCUM, DIM_PROPERTY
RESIAIMS_HOA_TABLE=
RESIAIMS_HOA_PROPERTY_TABLE=
RESIAIMS_ACCESS_CODES_TABLE=
RESIAIMS_HOA_ACCUM_TABLE=
RESIAIMS_PROPERTY_TABLE=
# SCD current-row filter shared by DIM_HOA / DIM_PROPERTY (defaults: CURRENT_FLAG = 'Y'):
RESIAIMS_CURRENT_FLAG_COL=
RESIAIMS_CURRENT_FLAG_VAL=
# Common join keys (defaults shown):
RESIAIMS_HOA_KEY_COL=            # DIM_HOA.HOA_KEY (surrogate join key)
RESIAIMS_HOA_ID_COL=             # DIM_HOA.HOA_ID (business id)
RESIAIMS_HOA_PROPERTY_PROP_KEY_COL=  # FCT_HOA_PROPERTY.PROPERTY_KEY
RESIAIMS_PROPERTY_KEY_COL=       # DIM_PROPERTY.PROPERTY_KEY

# --- App ----------------------------------------------------------------
# Optional shared secret to protect the data-lookup API routes.
# If set, callers must send header:  x-api-key: <value>
API_LOOKUP_KEY=
