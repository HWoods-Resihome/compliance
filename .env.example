# =========================================================================
# ResiHome Compliance — Environment Variables (EXAMPLE)
# -------------------------------------------------------------------------
# Copy to `.env.local` for local development. NEVER commit real secrets.
# In production, set these in the Vercel Project Settings → Environment
# Variables (Production scope). See docs/ENVIRONMENT.md.
# =========================================================================

# --- HubSpot (Private App token) ---------------------------------------
# Create a Private App in HubSpot and copy its access token.
# Scopes typically needed: crm.objects.contacts.read, crm.objects.companies.read,
# crm.objects.deals.read (adjust to your compliance use case).
HUBSPOT_TOKEN=

# --- Snowflake ----------------------------------------------------------
# Account identifier, e.g. "abc12345.us-east-1" or "orgname-accountname".
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# --- ResiAIMS associations (HOA) schema mapping -------------------------
# The /associations feature reads HOA/association data from the same
# Snowflake account (creds above). These OPTIONAL vars override the
# ResiAIMS table/column names used to build the extraction queries — set
# them only if the account's objects differ from the defaults in
# src/lib/associations.ts. Leave blank to use the defaults.
#
# Database + schema the association objects live in (default: SNOWFLAKE_* above):
RESIAIMS_DATABASE=
RESIAIMS_SCHEMA=
# Table names (bare table, or fully-qualified DB.SCHEMA.TABLE):
RESIAIMS_ASSOCIATIONS_TABLE=
RESIAIMS_AMENITIES_TABLE=
RESIAIMS_ACCESS_CODES_TABLE=
RESIAIMS_INSPECTIONS_TABLE=
RESIAIMS_PROPERTIES_TABLE=
# Key columns. The HOA-tab fields (status, fax, EIN/TaxID, invoice recovery,
# management company + 3 mgmt POCs, physical/mailing address, and 3 points of
# contact) are all columns on the ASSOCIATIONS record and each has its own
# RESIAIMS_ASSOC_* override — see src/lib/associations.ts for the full list.
RESIAIMS_ASSOC_ID_COL=
RESIAIMS_ASSOC_NAME_COL=
RESIAIMS_PROPERTY_ASSOC_FK_COL=

# --- App ----------------------------------------------------------------
# Optional shared secret to protect the data-lookup API routes.
# If set, callers must send header:  x-api-key: <value>
API_LOOKUP_KEY=
